{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ostean canonical TypeScript configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "identity", "release", "language", "languageSocket", "runtimeVersion", "lineLimits", "comments", "ui", "verification", "testing", "externalDependencies"],
  "properties": {
    "$schema": { "const": "./ostean.schema.json" },
    "schemaVersion": { "const": 1 },
    "identity": { "const": "Ostean" },
    "release": { "const": "v_final" },
    "language": { "const": "ts" },
    "languageSocket": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version"],
      "properties": { "name": { "const": "typescript" }, "version": { "const": "5.7.3" } }
    },
    "runtimeVersion": { "$ref": "#/$defs/exactVersion" },
    "lineLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["core", "primitives", "components", "services", "workflows", "runtime"],
      "properties": {
        "core": { "const": 150 }, "primitives": { "const": 50 },
        "components": { "const": 100 }, "services": { "const": 150 },
        "workflows": { "const": 150 }, "runtime": { "const": 100 }
      }
    },
    "comments": {
      "type": "object", "additionalProperties": false,
      "required": ["functionWords", "coreTokenWords"],
      "properties": { "functionWords": { "const": 10 }, "coreTokenWords": { "const": 5 } }
    },
    "ui": {
      "type": "object", "additionalProperties": false,
      "required": ["directory", "maxCompositionHops"],
      "properties": { "directory": { "const": "components/ui" }, "maxCompositionHops": { "const": 2 } }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["failClosed", "cloneStatements", "cloneNodes", "canonicalCoreFiles"],
      "properties": {
        "failClosed": { "const": true }, "cloneStatements": { "const": 3 },
        "cloneNodes": { "const": 15 },
        "canonicalCoreFiles": { "const": ["constants.ts", "errors.ts", "schemas.ts", "styles.css"] }
      }
    },
    "testing": {
      "type": "object", "additionalProperties": false,
      "required": ["seed", "privateCases"],
      "properties": {
        "seed": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "privateCases": { "type": "integer", "minimum": 100 }
      }
    },
    "externalDependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["core", "primitives", "components", "components/ui", "services", "workflows", "runtime", "tests"],
      "properties": {
        "core": { "$ref": "#/$defs/emptyLayer" },
        "primitives": { "$ref": "#/$defs/emptyLayer" },
        "components": { "$ref": "#/$defs/emptyLayer" },
        "components/ui": { "$ref": "#/$defs/dependencyLayer" },
        "services": { "$ref": "#/$defs/dependencyLayer" },
        "workflows": { "$ref": "#/$defs/emptyLayer" },
        "runtime": { "$ref": "#/$defs/dependencyLayer" },
        "tests": { "$ref": "#/$defs/dependencyLayer" }
      }
    }
  },
  "$defs": {
    "exactVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?(\\+[0-9A-Za-z]+([.-][0-9A-Za-z]+)*)?$"
    },
    "emptyLayer": { "type": "object", "maxProperties": 0 },
    "dependencyLayer": { "type": "object", "additionalProperties": { "$ref": "#/$defs/dependency" } },
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "entrypoints"],
      "properties": {
        "version": { "anyOf": [{ "$ref": "#/$defs/exactVersion" }, { "const": "builtin" }] },
        "entrypoints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
